APP_NAME=Hebron
# Private print artifact disk; use a dedicated private S3 disk for shared deployments.
PRINT_PDF_FILESYSTEM_DISK=local
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

ADMIN_DEFAULT_PASSWORD=Hebron2026!
L5_SWAGGER_CONST_HOST=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=db_hebron
DB_USERNAME=admin
DB_PASSWORD=svc_app_p8l
DB_ROOT_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Laravel Reverb / frontend Echo configuration
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public browser connection (React/Echo -> reverse proxy -> Reverb).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Internal Laravel/queue connection (Docker -> Reverb service).
REVERB_INTERNAL_HOST=reverb
REVERB_INTERNAL_PORT=8080
REVERB_INTERNAL_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=s3-private
PUBLIC_FILESYSTEM_DISK=s3-public
PRIVATE_FILESYSTEM_DISK=s3-private
PRIVATE_FILE_URL_TTL=10
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Naver SMTP (production): enable IMAP/SMTP, 2FA, and create an application password.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.naver.com
MAIL_PORT=587
MAIL_USERNAME=notification@naver.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=30
# Use the production server's valid FQDN when the SMTP provider requires EHLO identification.
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS=notification@naver.com
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_ORDER_NOTIFICATION_EMAILS=

# Inquiry notifications
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_NUMBER=
ALIGO_SENDER_KEY=
# Set true to send real SMS from staging/production.
ALIGO_SMS_ENABLED=false
ALIGO_TEST_MODE=false
ALIGO_BASE_URL=https://kakaoapi.aligo.in
ALIGO_INQUIRY_REPLY_GUEST_TEMPLATE=UL_0664
ALIGO_INQUIRY_REPLY_MEMBER_TEMPLATE=UL_0661
ALIGO_BRAND_SHOP_NAME="${APP_NAME}"
ALIGO_PLAIN_SHOP_NAME="${APP_NAME}"
ALIGO_SHOPPING_MALL_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
AWS_BUCKET=hebron-storage
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
TOSS_TIMEOUT=30
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_BASE_URL=https://api.tosspayments.com

SWEETTRACKER_INFO_BASE_URL=https://info.sweettracker.co.kr
# Supplied by SweetTracker for your contract (the public docs only show {host}).
SWEETTRACKER_TRACE_BASE_URL=
SWEETTRACKER_API_KEY=
SWEETTRACKER_TIER=
SWEETTRACKER_KEY=
SWEETTRACKER_WEBHOOK_SECRET=
SWEETTRACKER_TIMEOUT=15
SWEETTRACKER_COMPANY_LIST_PATH=/api/v1/companylist
SWEETTRACKER_TRACKING_INFO_PATH=/api/v1/trackingInfo
SWEETTRACKER_POLL_INTERVAL_MINUTES=30
SWEETTRACKER_REGISTER_PATH=/add_invoice
SWEETTRACKER_WEBHOOK_PATH=/api/webhooks/sweettracker/tracking

MES_STOCK_SYNC_ENABLED=true

PULSE_PATH=monitor
